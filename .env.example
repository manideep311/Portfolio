# Copy to .env for local development (never commit .env).
# In production set these as environment variables on your host.

# --- Core -------------------------------------------------------------
DJANGO_DEBUG=1
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required in production for HTTPS form posts, e.g. https://manideep.dev
DJANGO_CSRF_TRUSTED_ORIGINS=
# Public URL used for canonical links, Open Graph and the sitemap
SITE_URL=http://localhost:8000
# Admin path (no leading slash). Changing it reduces bot noise.
DJANGO_ADMIN_URL=admin/

# --- Database -----------------------------------------------------------
# Empty = local SQLite (db.sqlite3). Production: a PostgreSQL URL.
DATABASE_URL=
# DATABASE_URL=postgres://user:password@host:5432/portfolio
DATABASE_SSL_REQUIRE=0

# --- Media (uploads) ---------------------------------------------------------
# Empty bucket = files saved to ./media (fine locally, NOT on Render/Railway/Fly).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com  (leave empty for AWS S3)
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
# Public domain that serves the bucket, e.g. media.manideep.dev or pub-xxxx.r2.dev
AWS_S3_CUSTOM_DOMAIN=
# R2 + recent boto3: only send checksums when required
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
# Only for a persistent-disk setup without object storage
SERVE_MEDIA=0

MAX_IMAGE_UPLOAD_MB=8
MAX_DOCUMENT_UPLOAD_MB=10
IMAGE_MAX_EDGE=2000

# --- Contact form notifications (messages are always saved in the admin) ---
CONTACT_NOTIFY_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=portfolio@localhost
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=3600
# Set to 1 behind Render/Railway/Fly/Heroku so rate limiting sees the real client IP
TRUST_X_FORWARDED_FOR=0

# --- Production security (defaults are already strict when DEBUG is off) ---
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# --- One-off: load the résumé content on the first deploy ---
SEED_ON_DEPLOY=0
